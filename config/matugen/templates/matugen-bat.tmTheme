<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>Matugen</string>
    <key>semanticClass</key>
    <string>theme.matugen</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>settings</key>
    <array>
      <dict>
        <key>settings</key>
        <dict>
          <key>background</key>
          <string>{{ colors.surface.default.hex }}</string>
          <key>foreground</key>
          <string>{{ colors.on_surface.default.hex }}</string>
          <key>caret</key>
          <string>{{ colors.primary.default.hex }}</string>
          <key>lineHighlight</key>
          <string>{{ colors.surface_container_high.default.hex }}</string>
          <key>misspelling</key>
          <string>{{ colors.error.default.hex }}</string>
          <key>accent</key>
          <string>{{ colors.primary.default.hex }}</string>
          <key>selection</key>
          <string>{{ colors.primary_container.default.hex }}</string>
          <key>activeGuide</key>
          <string>{{ colors.outline.default.hex }}</string>
          <key>findHighlight</key>
          <string>{{ colors.tertiary_container.default.hex }}</string>
          <key>gutterForeground</key>
          <string>{{ colors.outline.default.hex }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Basic text &amp; variables</string>
        <key>scope</key>
        <string>text, source, variable.other.readwrite, punctuation.definition.variable</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.on_surface.default.hex }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Punctuation</string>
        <key>scope</key>
        <string>punctuation</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.on_surface_variant.default.hex }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Comments</string>
        <key>scope</key>
        <string>comment, punctuation.definition.comment</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.outline.default.hex }}</string>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Strings</string>
        <key>scope</key>
        <string>string, punctuation.definition.string</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.green.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Escapes</string>
        <key>scope</key>
        <string>constant.character.escape</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.cyan.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Constants &amp; Numbers</string>
        <key>scope</key>
        <string>constant.numeric, variable.other.constant, entity.name.constant, constant.language, keyword.other.unit</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.yellow.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Keywords &amp; Storage</string>
        <key>scope</key>
        <string>keyword, keyword.operator.word, keyword.operator.new, variable.language, storage.type, storage.modifier, punctuation.definition.keyword</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.magenta.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Operators</string>
        <key>scope</key>
        <string>keyword.operator</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.cyan.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Functions &amp; Methods</string>
        <key>scope</key>
        <string>entity.name.function, support.function, meta.function-call</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.blue.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Types &amp; Classes</string>
        <key>scope</key>
        <string>entity.name.type, entity.name.class, entity.name.struct, support.type, support.class</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.yellow.default.hex | auto_lightness: 5 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Tags &amp; Attributes</string>
        <key>scope</key>
        <string>entity.name.tag, entity.other.attribute-name</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.red.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Diff Inserted</string>
        <key>scope</key>
        <string>markup.inserted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.green.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Diff Deleted</string>
        <key>scope</key>
        <string>markup.deleted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.red.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Diff Changed</string>
        <key>scope</key>
        <string>markup.changed</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.yellow.default.hex | auto_lightness: 10 }}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Markdown Headings</string>
        <key>scope</key>
        <string>markup.heading, markup.heading.1.markdown, markup.heading.2.markdown</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.primary.default.hex }}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Invalid / Error</string>
        <key>scope</key>
        <string>invalid, invalid.illegal</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{ colors.on_error.default.hex }}</string>
          <key>background</key>
          <string>{{ colors.error.default.hex }}</string>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
