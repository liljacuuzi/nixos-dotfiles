/*
 * PCManFM-Qt Matugen Theme Template (Material You)
 * Generated dynamically by matugen into ~/.cache/matugen/pcmanfm-qt.qss
 */

QWidget, QMainWindow, QDialog {
    background-color: {{ colors.surface.default.hex }};
    color: {{ colors.on_surface.default.hex }};
}

QFrame {
    border-color: {{ colors.outline_variant.default.hex }};
}

/* Main folder view & Side pane (Places, Directory Tree) */
QTreeView, QListView, QTableView,
QAbstractItemView {
    background-color: {{ colors.surface.default.hex }};
    alternate-background-color: {{ colors.surface_container_low.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    selection-background-color: {{ colors.primary.default.hex }};
    selection-color: {{ colors.on_primary.default.hex }};
    border: none;
    outline: none;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
    background-color: {{ colors.surface_container_high.default.hex }};
    color: {{ colors.on_surface.default.hex }};
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active {
    background-color: {{ colors.primary_container.default.hex }};
    color: {{ colors.on_primary_container.default.hex }};
}

/* Header columns (Name, Size, Modified, Type) */
QHeaderView::section {
    background-color: {{ colors.surface_container.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    padding: 4px 8px;
    font-weight: bold;
}

/* Menu Bar & Context Menus */
QMenuBar {
    background-color: {{ colors.surface.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border-bottom: 1px solid {{ colors.outline_variant.default.hex }};
}

QMenuBar::item {
    background: transparent;
    color: {{ colors.on_surface.default.hex }};
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

QMenu {
    background-color: {{ colors.surface_container_high.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
}

QMenu::item {
    padding: 5px 20px;
    background: transparent;
}

QMenu::item:selected {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

QMenu::item:disabled {
    color: {{ colors.on_surface_variant.default.hex }};
}

QMenu::separator {
    height: 1px;
    background-color: {{ colors.outline_variant.default.hex }};
    margin: 4px 8px;
}

/* Dialog buttons, dropdowns & tooltips */
QPushButton, QComboBox {
    background-color: {{ colors.surface_container_high.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton:hover, QComboBox:hover {
    background-color: {{ colors.surface_bright.default.hex }};
    border-color: {{ colors.outline.default.hex }};
}

QPushButton:pressed {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

QComboBox QAbstractItemView {
    background-color: {{ colors.surface_container_high.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    selection-background-color: {{ colors.primary.default.hex }};
    selection-color: {{ colors.on_primary.default.hex }};
}

QToolTip {
    background-color: {{ colors.surface_container_highest.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    padding: 4px 6px;
}

/* ToolBar & Navigation Controls */
QToolBar {
    background-color: {{ colors.surface.default.hex }};
    border-bottom: 1px solid {{ colors.outline_variant.default.hex }};
    spacing: 3px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    color: {{ colors.on_surface.default.hex }};
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background-color: {{ colors.surface_container_high.default.hex }};
    color: {{ colors.on_surface.default.hex }};
}

QToolButton:pressed,
QToolButton:checked {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

/* Location Bar / Path bar / Search Edit */
QLineEdit {
    background-color: {{ colors.surface_container.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    border-radius: 3px;
    padding: 3px 6px;
    selection-background-color: {{ colors.primary.default.hex }};
    selection-color: {{ colors.on_primary.default.hex }};
}

QLineEdit:focus {
    border-color: {{ colors.primary.default.hex }};
}

/* Tab Bar */
QTabBar::tab {
    background-color: {{ colors.surface_container.default.hex }};
    color: {{ colors.on_surface.default.hex }};
    border: 1px solid {{ colors.outline_variant.default.hex }};
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: {{ colors.primary.default.hex }};
    color: {{ colors.on_primary.default.hex }};
}

QTabBar::tab:hover:!selected {
    background-color: {{ colors.surface_container_high.default.hex }};
}

/* Status Bar */
QStatusBar {
    background-color: {{ colors.surface.default.hex }};
    color: {{ colors.on_surface_variant.default.hex }};
    border-top: 1px solid {{ colors.outline_variant.default.hex }};
}

/* Splitter between Places and Folder View */
QSplitter::handle {
    background-color: {{ colors.outline_variant.default.hex }};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: {{ colors.surface.default.hex }};
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: {{ colors.outline_variant.default.hex }};
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{ colors.primary.default.hex }};
}

QScrollBar:horizontal {
    background-color: {{ colors.surface.default.hex }};
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: {{ colors.outline_variant.default.hex }};
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{ colors.primary.default.hex }};
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
