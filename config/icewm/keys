# Launch a terminal
key "Ctrl+Alt+t" xterm

# Launch a browser
key "Ctrl+Alt+b" firefox

# Take a screenshot
key "Print" maim ~/screenshot.png


# Move/Tile Window to Left Half
key "Super+Alt+Left" icesh -f restore sizeto 50% 100% left top

# Move/Tile Window to Right Half
key "Super+Alt+Right" icesh -f restore sizeto 50% 100% right top

# Move/Tile Window to Top Half
key "Super+Alt+Up" icesh -f restore sizeto 100% 50% left top

# Move/Tile Window to Bottom Half
key "Super+Alt+Down" icesh -f restore sizeto 100% 50% left bottom

# Maximize / Restore Toggle
key "Super+Alt+x" sh -c "if icesh -f -a getStates | grep -q Maximized; then icesh -f restore; else icesh -f maximize; fi"

# turn on rofi
key "Super+space" rofi -show drun

# Volume keys
key "XF86AudioRaiseVolume" wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
key "XF86AudioLowerVolume" wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
key "XF86AudioMute" wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness keys
key "XF86MonBrightnessDown" brightnessctl set 10%-
key "XF86MonBrightnessUp" brightnessctl set 10%+


