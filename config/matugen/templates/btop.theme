# Theme: matugen Base16 generated
# Generated dynamically via matugen (Base16 dark palette)

theme[main_bg]="{{ base16.base00.dark.hex }}"
theme[main_fg]="{{ base16.base05.dark.hex }}"

# Title color for boxes
theme[title]="{{ base16.base05.dark.hex }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ base16.base08.dark.hex }}"

# Selected item in processes box
theme[selected_bg]="{{ base16.base02.dark.hex }}"
theme[selected_fg]="{{ base16.base0c.dark.hex }}"

# Inactive / muted UI elements and meter background
theme[inactive_fg]="{{ base16.base03.dark.hex }}"
theme[graph_text]="{{ base16.base05.dark.hex }}"
theme[meter_bg]="{{ base16.base01.dark.hex }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ base16.base0c.dark.hex }}"

# Box outline colors
theme[cpu_box]="{{ base16.base0d.dark.hex }}"
theme[mem_box]="{{ base16.base0d.dark.hex }}"
theme[net_box]="{{ base16.base0d.dark.hex }}"
theme[proc_box]="{{ base16.base0d.dark.hex }}"
theme[div_line]="{{ base16.base03.dark.hex }}"

# Temperature graph colors
theme[temp_start]="{{ base16.base0b.dark.hex }}"
theme[temp_mid]="{{ base16.base0a.dark.hex }}"
theme[temp_end]="{{ base16.base08.dark.hex }}"

# CPU graph colors
theme[cpu_start]="{{ base16.base0b.dark.hex }}"
theme[cpu_mid]="{{ base16.base0a.dark.hex }}"
theme[cpu_end]="{{ base16.base08.dark.hex }}"

# Mem/Disk free meter
theme[free_start]="{{ base16.base0b.dark.hex }}"
theme[free_mid]="{{ base16.base0a.dark.hex }}"
theme[free_end]="{{ base16.base08.dark.hex }}"

# Mem/Disk cached meter
theme[cached_start]="{{ base16.base0b.dark.hex }}"
theme[cached_mid]="{{ base16.base0a.dark.hex }}"
theme[cached_end]="{{ base16.base08.dark.hex }}"

# Mem/Disk available meter
theme[available_start]="{{ base16.base0b.dark.hex }}"
theme[available_mid]="{{ base16.base0a.dark.hex }}"
theme[available_end]="{{ base16.base08.dark.hex }}"

# Mem/Disk used meter
theme[used_start]="{{ base16.base0b.dark.hex }}"
theme[used_mid]="{{ base16.base0a.dark.hex }}"
theme[used_end]="{{ base16.base08.dark.hex }}"

# Download graph colors
theme[download_start]="{{ base16.base0b.dark.hex }}"
theme[download_mid]="{{ base16.base0a.dark.hex }}"
theme[download_end]="{{ base16.base08.dark.hex }}"

# Upload graph colors
theme[upload_start]="{{ base16.base0b.dark.hex }}"
theme[upload_mid]="{{ base16.base0a.dark.hex }}"
theme[upload_end]="{{ base16.base08.dark.hex }}"

# Process box color gradient
theme[process_start]="{{ base16.base0b.dark.hex }}"
theme[process_mid]="{{ base16.base0d.dark.hex }}"
theme[process_end]="{{ base16.base0e.dark.hex }}"
