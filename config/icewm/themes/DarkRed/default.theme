# ===================================================================
# Custom IceWM Theme matching Openbox / GTK3 Deep Red Dark Theme
# ===================================================================

ThemeAuthor="Custom"
ThemeDescription="Flat dark theme with deep red active highlights"
Look=flat

# -------------------------------------------------------------------
# 1. Window Decorations & Titlebars
# -------------------------------------------------------------------
TitleBarHeight=24
TitleJustify=0                           # 0=Left, 1=Center, 2=Right
BorderSizeX=2
BorderSizeY=2
CornerSizeX=4
CornerSizeY=4

# Active Window
ColorActiveTitleBar="#0F0F0F"
ColorActiveTitleBarText="#640B0C"
ColorActiveBorder="#1A1A1A"
ColorActiveTitleBarShadow="#0F0F0F"

# Inactive Window
ColorInactiveTitleBar="#050505"
ColorInactiveTitleBarText="#5C5F66"
ColorInactiveBorder="#0F0F0F"
ColorInactiveTitleBarShadow="#050505"

# Window Title Buttons
ColorTitleButton="#0F0F0F"
ColorTitleButtonText="#640B0C"
ColorTitleButtonHover="#640B0C"
ColorTitleButtonActive="#640B0C"

# -------------------------------------------------------------------
# 2. Menus & Context Menus
# -------------------------------------------------------------------
ColorMenu="#050505"
ColorMenuBorder="#1A1A1A"
ColorNormalMenuItemText="#E3E6ED"

# Active / Hovered Menu Item
ColorActiveMenuItem="#640B0C"
ColorActiveMenuItemText="#FFFFFF"

# Disabled Menu Item
ColorDisabledMenuItemText="#4A4D52"

# Menu Title Headers
ColorMenuTitleBar="#0F0F0F"
ColorMenuTitleBarText="#640B0C"

# -------------------------------------------------------------------
# 3. Panel / Taskbar
# -------------------------------------------------------------------
ColorDefaultTaskBar="#0F0F0F"
ColorTaskBarBorder="#1A1A1A"

# Start / Menu Button on Taskbar
ColorToolButton="#0F0F0F"
ColorToolButtonText="#E3E6ED"
ColorToolButtonHover="#640B0C"

# Task Buttons (Window list in panel)
ColorNormalTaskBarApp="#050505"
ColorNormalTaskBarAppText="#E3E6ED"

ColorActiveTaskBarApp="#640B0C"
ColorActiveTaskBarAppText="#FFFFFF"

ColorMinimizedTaskBarApp="#050505"
ColorMinimizedTaskBarAppText="#5C5F66"

ColorInvisibleTaskBarApp="#050505"
ColorInvisibleTaskBarAppText="#4A4D52"

# -------------------------------------------------------------------
# 4. Desktop Switcher / Workspace Pager
# -------------------------------------------------------------------
ColorWorkspaceButton="#050505"
ColorWorkspaceButtonText="#5C5F66"
ColorWorkspaceButtonBorder="#1A1A1A"

ColorActiveWorkspaceButton="#640B0C"
ColorActiveWorkspaceButtonText="#FFFFFF"
ColorActiveWorkspaceButtonBorder="#640B0C"

# Workspace Preview Window Backgrounds
ColorNormalWorkspace="#050505"
ColorActiveWorkspace="#0F0F0F"

# -------------------------------------------------------------------
# 5. Default Widgets, Tray & Clock
# -------------------------------------------------------------------
# Clock
ColorClock="#0F0F0F"
ColorClockText="#E3E6ED"

# CPU Status Widget
ColorCPUStatusUser="#640B0C"
ColorCPUStatusSystem="#5C5F66"
ColorCPUStatusIdle="#050505"
ColorCPUStatusInterrupts="#A01214"

# Network Status Widget
ColorNetSend="#640B0C"
ColorNetReceive="#E3E6ED"
ColorNetIdle="#050505"

# Memory Status Widget
ColorMEMStatusUser="#640B0C"
ColorMEMStatusBuffering="#5C5F66"
ColorMEMStatusCached="#1A1A1A"
ColorMEMStatusFree="#050505"

# -------------------------------------------------------------------
# 6. Alt+Tab Quick Switcher & Tooltips
# -------------------------------------------------------------------
# Quick Switcher (Alt+Tab window)
ColorQuickSwitch="#0F0F0F"
ColorQuickSwitchText="#E3E6ED"
ColorQuickSwitchActive="#640B0C"
ColorQuickSwitchBorder="#1A1A1A"

# Tooltips
ColorToolTip="#050505"
ColorToolTipText="#E3E6ED"
ColorToolTipBorder="#1A1A1A"

# -------------------------------------------------------------------
# 7. Dialogs, Lists & Input Fields
# -------------------------------------------------------------------
ColorDialog="#050505"
ColorLabel="#050505"
ColorLabelText="#E3E6ED"

ColorListBox="#050505"
ColorListBoxText="#E3E6ED"
ColorListBoxSelection="#640B0C"
ColorListBoxSelectionText="#FFFFFF"

ColorScrollBar="#0F0F0F"
ColorScrollBarSlider="#1A1A1A"
ColorScrollBarButton="#0F0F0F"
ColorScrollBarButtonArrow="#E3E6ED"
