! Matugen Material You Xresources for st and X11 terminal programs
! Grayscale/surfaces from Material You tokens; chromatic ANSI hues from blended custom_colors
*.foreground:   {{ colors.on_surface.default.hex }}
*.background:   {{ colors.surface.default.hex }}
*foreground:    {{ colors.on_surface.default.hex }}
*background:    {{ colors.surface.default.hex }}

st.foreground:  {{ colors.on_surface.default.hex }}
st.background:  {{ colors.surface.default.hex }}
st.cursorColor: {{ colors.primary.default.hex }}
st.color0:      {{ colors.surface.default.hex }}
st.color1:      {{ colors.red.default.hex | auto_lightness: 15 }}
st.color2:      {{ colors.green.default.hex | auto_lightness: 15 }}
st.color3:      {{ colors.yellow.default.hex | auto_lightness: 15 }}
st.color4:      {{ colors.blue.default.hex | auto_lightness: 15 }}
st.color5:      {{ colors.magenta.default.hex | auto_lightness: 15 }}
st.color6:      {{ colors.cyan.default.hex | auto_lightness: 15 }}
st.color7:      {{ colors.on_surface_variant.default.hex }}
st.color8:      {{ colors.outline.default.hex }}
st.color9:      {{ colors.red.default.hex | auto_lightness: 5 }}
st.color10:     {{ colors.green.default.hex | auto_lightness: 5 }}
st.color11:     {{ colors.yellow.default.hex | auto_lightness: 5 }}
st.color12:     {{ colors.blue.default.hex | auto_lightness: 5 }}
st.color13:     {{ colors.magenta.default.hex | auto_lightness: 5 }}
st.color14:     {{ colors.cyan.default.hex | auto_lightness: 5 }}
st.color15:     {{ colors.on_surface.default.hex }}

*.color0:       {{ colors.surface.default.hex }}
*.color1:       {{ colors.red.default.hex | auto_lightness: 15 }}
*.color2:       {{ colors.green.default.hex | auto_lightness: 15 }}
*.color3:       {{ colors.yellow.default.hex | auto_lightness: 15 }}
*.color4:       {{ colors.blue.default.hex | auto_lightness: 15 }}
*.color5:       {{ colors.magenta.default.hex | auto_lightness: 15 }}
*.color6:       {{ colors.cyan.default.hex | auto_lightness: 15 }}
*.color7:       {{ colors.on_surface_variant.default.hex }}
*.color8:       {{ colors.outline.default.hex }}
*.color9:       {{ colors.red.default.hex | auto_lightness: 5 }}
*.color10:      {{ colors.green.default.hex | auto_lightness: 5 }}
*.color11:      {{ colors.yellow.default.hex | auto_lightness: 5 }}
*.color12:      {{ colors.blue.default.hex | auto_lightness: 5 }}
*.color13:      {{ colors.magenta.default.hex | auto_lightness: 5 }}
*.color14:      {{ colors.cyan.default.hex | auto_lightness: 5 }}
*.color15:      {{ colors.on_surface.default.hex }}
