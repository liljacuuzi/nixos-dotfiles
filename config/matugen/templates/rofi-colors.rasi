* {
    bg: {{ colors.surface.default.hex }};
    hv: {{ colors.primary.default.hex }};
    primary: {{ colors.outline_variant.default.hex }};
    ug: {{ colors.error.default.hex }};
    kl: {{ colors.on_surface.default.hex }};
    black: {{ colors.on_primary.default.hex }};
    transparent: rgba(0, 0, 0, 0);
}
