+static bool notification_is_firefox(const struct notification *n)
+{
+        if (n->appname && g_ascii_strncasecmp(n->appname, "firefox", 7) == 0)
+                return true;
+        if (n->desktop_entry && g_strstr_len(n->desktop_entry, -1, "firefox") != NULL)
+                return true;
+        return false;
+}
+
+static void notification_focus_firefox(const struct notification *n)
+{
+        if (!notification_is_firefox(n))
+                return;
+
+        GError *err = NULL;
+        if (!g_spawn_command_line_async("oxwm-focus-firefox", &err)) {
+                LOG_W("Unable to run oxwm-focus-firefox: %s",
+                      err ? err->message : "unknown");
+                g_clear_error(&err);
+        }
+}
