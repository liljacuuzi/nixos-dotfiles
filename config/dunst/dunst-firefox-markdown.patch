+/**
+ * Find closing markdown delimiter (e.g. "***", "**", "*", "~~", "__", "_")
+ * within s[start..len), skipping existing XML/Pango tags and backslash escapes.
+ */
+static ssize_t md_find_closing(const char *s, size_t len, size_t start,
+                               const char *delim, size_t dlen, bool word_boundary)
+{
+        for (size_t i = start; i + dlen <= len; i++) {
+                if (s[i] == '\\' && i + 1 < len) {
+                        i++;
+                        continue;
+                }
+                if (s[i] == '<') {
+                        const char *gt = memchr(s + i, '>', len - i);
+                        if (gt) {
+                                i = (size_t)(gt - s);
+                                continue;
+                        }
+                }
+                if (memcmp(s + i, delim, dlen) == 0) {
+                        /* Avoid matching ** when searching for single * */
+                        if (dlen == 1 && (delim[0] == '*' || delim[0] == '_')) {
+                                if (i + 1 < len && s[i + 1] == delim[0]) {
+                                        i++;
+                                        continue;
+                                }
+                        }
+                        /* Closing delimiter cannot be preceded by whitespace */
+                        if (i > start && !isspace((unsigned char)s[i - 1])) {
+                                if (word_boundary && i + dlen < len &&
+                                    isalnum((unsigned char)s[i + dlen])) {
+                                        continue;
+                                }
+                                return (ssize_t)i;
+                        }
+                }
+        }
+        return -1;
+}
